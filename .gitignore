# ===== Python 缓存 / 构建产物 =====
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# ===== 虚拟环境 =====
.venv/
venv/
env/

# ===== IDE（PyCharm / VS Code 等本地配置，不进版本库）=====
.idea/
.vscode/

# ===== 数据集（按 README：不上传 GitHub，仅本地保留）=====
data/*
!data/.gitkeep

# ===== 模型权重 / 大文件（避免塞爆仓库）=====
*.pt
*.pth
*.h5
*.onnx
*.ckpt
*.bin

# ===== 系统垃圾文件 =====
.DS_Store
Thumbs.db

# ===== 大文件 / 含凭证工具（不进版本库）=====
*.zip
华为数据下载工具/
notebooks/*.png
队友交接包*/
队友_开工包*

# ===== 模型权重（2026-09-26 补）=====
# model.pkl 546MB / model.pkl.gz 118MB —— 远超 GitHub 单文件 100MB 上限
*.pkl
*.pkl.gz

# ===== 运行产物（可随时重新生成，不进版本库）=====
answer.csv
result.csv

# ===== 临时脚本与中间产物（_ 前缀 = 一次性）=====
_*.py
_*.txt
_*.json
_*.bak
*.bak

# ===== 交付/打包产物 =====
dist/
build/
*.spec
